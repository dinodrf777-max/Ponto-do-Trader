rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /players/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Game balances are fictional; each player can save only their own game state.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'state', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.state is map;

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['email', 'state', 'updatedAt'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.state is map);

      allow delete: if isAdmin();
    }

    match /game/{document} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Admin records must be created manually in the Firebase Console.
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
  }
}